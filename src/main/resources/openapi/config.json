{
  "modelPackage": "com.epam.reportportal.extension.jira.api.model",
  "apiPackage": "com.epam.reportportal.extension.jira.api",
  "invokerPackage": "com.epam.reportportal.extension.jira.api.client",
  "library": "restclient",
  "groupId": "com.atlassian.jira.rest",
  "artifactId": "client",
  "dateLibrary": "java8",
  "generateClientAsBean": true,
  "hideGenerationTimestamp": true,
  "interfaceOnly": true,
  "skipOperationExample": true,
  "documentationProvider": "none",
  "openapiNormalizer": {
    "REF_AS_PARENT_IN_ALLOF": true
  },
  "modelNameMappings": {
    "Locale": "JiraLocale"
  },
  "java21": true,
  "useSpringBoot4": true,
  "useJackson3": true,
  "useJakartaEe": true,
  "openApiNullable": false,
  "skipOverwrite": true,
  "useTags": true
}
